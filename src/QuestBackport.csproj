<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShinnisQuestsBackport</AssemblyName>
    <RootNamespace>QuestBackport</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Compile against SPT's and WTT's NuGet packages, so no SPT install is needed to build.
       The server already ships these DLLs, so none of them are copied into the output. -->
  <ItemGroup>
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
